DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Produção (https://www.linea.org.br/drd): nginx faz rewrite de /drd/
# DJANGO_ALLOWED_HOSTS=www.linea.org.br,linea.org.br
# DJANGO_FORCE_SCRIPT_NAME=/drd
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.linea.org.br,https://linea.org.br
# SITE_URL=https://www.linea.org.br/drd

# Produção: hash curto do commit (tag da imagem linea/idac_drd no Docker Hub)
WEB_IMAGE_TAG=

# Local: compose sobrescreve para o serviço database
# Produção: apontar para o Postgres de metadados
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

AUTH_SAML2_ENABLED=False
LINEA_LOGIN_URL=/admin/login/?next=/
RUBIN_LOGIN_URL=/admin/login/?next=/
# When AUTH_SAML2_ENABLED=True:
# SITE_URL=https://www.linea.org.br/drd
# LINEA_LOGIN_URL=/saml2/login/?idp=https://satosa.linea.org.br/linea/proxy/aHR0cHM6Ly9jaWxvZ29uLm9yZw==&next=/
# RUBIN_LOGIN_URL=/saml2/login/?idp=https://satosa.linea.org.br/linea/proxy/aHR0cHM6Ly9kYXRhLmxzc3QuY2xvdWQv&next=/
# SAML_SP_NAME=SP IDAC DRD
# (metadata IdP: hardcoded em config/settings/base.py)

NAVBAR_IDAC_URL=https://scienceplatform.linea.org.br/idac
NAVBAR_DATA_URL=https://data.linea.org.br/
NAVBAR_DOCS_URL=https://docs.linea.org.br/

# Github (REST API) — opcional; criação de issues só ocorre com GH_ENABLED=True
GH_ENABLED=False
# GH_TEST_TOKEN=
GH_TOKEN=

# Slack — opcional; envio de mensagens só ocorre com SLACK_ENABLED=True
SLACK_ENABLED=False
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Fallback de desenvolvimento: enquanto o canal não for definido, mensagens vão para este usuário
SLACK_DEV_USER_ID=

# GLPI (API REST) — opcional; criação de tickets só ocorre com GLPI_ENABLED=True
GLPI_ENABLED=False
# 186.232.60.44: https://helpdesk.linea.org.br/
# 186.232.60.56: https://helpdesk-dev.linea.org.br/
GLPI_API_URL=http://186.232.60.44/apirest.php
GLPI_USER=
GLPI_PASSWORD=
GLPI_APP_TOKEN=
# helpdesk-dev: HTTP (sem TLS). Cliente API aceita só origem 10.24.2.90–10.24.2.94.
# Documentação da API: https://helpdesk.linea.org.br/apirest.php
