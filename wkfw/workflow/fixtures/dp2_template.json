{
  "key": "dp2",
  "name": "DP2 Canonical Workflow",
  "version": 1,
  "is_active": true,
  "lanes": [
    {"key": "rucio-server", "label": "Rucio Server (USDF)", "order": 0, "color": "#000099"},
    {"key": "rucio-endpoint", "label": "Rucio Endpoint", "order": 1, "color": "#000099"},
    {"key": "data-management", "label": "Data Management", "order": 2, "color": "#000099"},
    {"key": "data-preparation", "label": "Data Preparation", "order": 3, "color": "#990000"},
    {"key": "skyviewer", "label": "Skyviewer", "order": 4, "color": "#CC0000"},
    {"key": "tap-service", "label": "TAP Service", "order": 5, "color": "#CC0000"},
    {"key": "lsdb", "label": "LSDB", "order": 6, "color": "#CC0000"},
    {"key": "cutout-service", "label": "Cutout Service", "order": 7, "color": "#CC0000"},
    {"key": "pz-server", "label": "PZ Server", "order": 8, "color": "#CC0000"},
    {"key": "pz-compute", "label": "PZ Compute", "order": 9, "color": "#CC0000"}
  ],
  "stages": [
    {"key": "send-files-dr", "label": "Send Files (Data Release)", "lane": "rucio-server", "order": 0, "depends_on": []},
    {"key": "receive-files-dr", "label": "Receive Files (Data Release)", "lane": "rucio-endpoint", "order": 0, "depends_on": ["send-files-dr"]},
    {"key": "move-files", "label": "Move Files (Lustre/NFS)", "lane": "data-management", "order": 0, "depends_on": ["receive-files-dr"]},
    {"key": "set-permissions-dm", "label": "Set permissions", "lane": "data-management", "order": 1, "depends_on": ["move-files"]},
    {"key": "qa-parquet", "label": "Run QA parquet files", "lane": "data-management", "order": 2, "depends_on": ["set-permissions-dm"]},
    {"key": "approve-qa-parquet", "label": "Inspect and approve QA (parquet)", "lane": "data-management", "order": 3, "depends_on": ["qa-parquet"]},
    {"key": "prepare-ingestion", "label": "Prepare ingestion scripts", "lane": "data-management", "order": 4, "depends_on": ["approve-qa-parquet"]},
    {"key": "ingest-postgres", "label": "Ingest tables into Postgres DB", "lane": "data-management", "order": 5, "depends_on": ["prepare-ingestion"]},
    {"key": "grant-permissions", "label": "Grant permissions", "lane": "data-management", "order": 6, "depends_on": ["ingest-postgres"]},
    {"key": "qa-postgres", "label": "Run QA postgres tables", "lane": "data-management", "order": 7, "depends_on": ["grant-permissions"]},
    {"key": "approve-qa-postgres", "label": "Inspect and approve QA (postgres)", "lane": "data-management", "order": 8, "depends_on": ["qa-postgres"]},
    {"key": "convert-hats", "label": "Convert to HATS", "lane": "data-preparation", "order": 0, "depends_on": ["approve-qa-parquet"]},
    {"key": "create-hips-catalog", "label": "Create HiPS Catalog", "lane": "data-preparation", "order": 1, "depends_on": ["approve-qa-parquet"]},
    {"key": "create-hips-images", "label": "Create HiPS Images", "lane": "data-preparation", "order": 2, "depends_on": ["approve-qa-parquet"]},
    {"key": "set-permissions-hats", "label": "Set permissions (HATS)", "lane": "data-preparation", "order": 3, "depends_on": ["convert-hats"]},
    {"key": "set-permissions-hips-cat", "label": "Set permissions (HiPS Catalog)", "lane": "data-preparation", "order": 4, "depends_on": ["create-hips-catalog"]},
    {"key": "set-permissions-hips-img", "label": "Set permissions (HiPS Images)", "lane": "data-preparation", "order": 5, "depends_on": ["create-hips-images"]},
    {"key": "register-hips-images", "label": "Register HiPS Images", "lane": "skyviewer", "order": 0, "depends_on": ["set-permissions-hips-img"]},
    {"key": "register-hips-catalog", "label": "Register HiPS Catalog", "lane": "skyviewer", "order": 1, "depends_on": ["set-permissions-hips-cat"]},
    {"key": "skyviewer-docs", "label": "Update DOCS/DATA (Skyviewer)", "lane": "skyviewer", "order": 2, "depends_on": ["register-hips-images", "register-hips-catalog"]},
    {"key": "register-daiquiri", "label": "Register tables on daiquiri", "lane": "tap-service", "order": 0, "depends_on": ["approve-qa-postgres"]},
    {"key": "update-daiquiri-doc", "label": "Update daiquiri doc (table schema)", "lane": "tap-service", "order": 1, "depends_on": ["register-daiquiri"]},
    {"key": "tap-tutorials", "label": "Update Tutorial notebooks (TAP)", "lane": "tap-service", "order": 2, "depends_on": ["register-daiquiri"]},
    {"key": "tap-docs", "label": "Update DOCS/DATA (TAP)", "lane": "tap-service", "order": 3, "depends_on": ["update-daiquiri-doc", "tap-tutorials"]},
    {"key": "lsdb-docs", "label": "Update DOCS/DATA (access via LSDB)", "lane": "lsdb", "order": 0, "depends_on": ["set-permissions-hats"]},
    {"key": "register-fits-skymap", "label": "Register FITS files (Skymap)", "lane": "cutout-service", "order": 0, "depends_on": ["approve-qa-parquet"]},
    {"key": "update-specz", "label": "Update Spec-z Compilation", "lane": "pz-server", "order": 0, "depends_on": ["approve-qa-postgres"]},
    {"key": "create-pz-training", "label": "Create PZ Training Set", "lane": "pz-server", "order": 1, "depends_on": ["update-specz"]},
    {"key": "upload-pz-training", "label": "Upload training files on PZ Server", "lane": "pz-server", "order": 2, "depends_on": ["create-pz-training"]},
    {"key": "pz-validation", "label": "Run PZ Validation notebook", "lane": "pz-server", "order": 3, "depends_on": ["upload-pz-training"]},
    {"key": "train-pz", "label": "Train PZ algos", "lane": "pz-compute", "order": 0, "depends_on": ["pz-validation", "set-permissions-hats"]},
    {"key": "run-pz-compute", "label": "Run PZ Compute", "lane": "pz-compute", "order": 1, "depends_on": ["train-pz"]},
    {"key": "qa-pz-hats", "label": "Run QA PZ Table HATS", "lane": "pz-compute", "order": 2, "depends_on": ["run-pz-compute"]},
    {"key": "approve-qa-pz-hats", "label": "Inspect and approve QA (PZ HATS)", "lane": "pz-compute", "order": 3, "depends_on": ["qa-pz-hats"]},
    {"key": "ingest-pz-postgres", "label": "Ingest PZ Table into Postgres DB", "lane": "pz-compute", "order": 4, "depends_on": ["approve-qa-pz-hats"]},
    {"key": "qa-pz-db", "label": "Run QA PZ Table DB", "lane": "pz-compute", "order": 5, "depends_on": ["ingest-pz-postgres"]},
    {"key": "approve-qa-pz-db", "label": "Inspect and approve QA (PZ DB)", "lane": "pz-compute", "order": 6, "depends_on": ["qa-pz-db"]},
    {"key": "pz-docs", "label": "Update DOCS/DATA (PZ)", "lane": "pz-compute", "order": 7, "depends_on": ["approve-qa-pz-db"]},
    {"key": "pz-tutorials", "label": "Update Tutorial notebooks (PZ)", "lane": "pz-compute", "order": 8, "depends_on": ["approve-qa-pz-db"]},
    {"key": "export-pz-rubin", "label": "Export PZ Table to Rubin", "lane": "rucio-endpoint", "order": 1, "depends_on": ["approve-qa-pz-db"]},
    {"key": "receive-pz-table", "label": "Receive Files (PZ table)", "lane": "rucio-server", "order": 1, "depends_on": ["export-pz-rubin"]}
  ]
}
